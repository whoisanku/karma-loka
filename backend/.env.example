# The HTTP RPC URL for the network (e.g., Base Sepolia)
BASE_SEPOLIA_RPC_URL=

# The private key of the wallet that will pay for gas fees (the relayer)
# IMPORTANT: Do NOT commit this to version control. This should be a new, funded wallet.
RELAYER_PRIVATE_KEY=

# The address of the trusted MinimalForwarder contract
FORWARDER_ADDRESS=

# The base URL of your frontend application for CORS
FRONTEND_URL=http://localhost:3000